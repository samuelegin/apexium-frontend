# Set this to your deployed API base if you want your local frontend to talk to the live backend.
# Example: VITE_API_BASE_URL=https://your-railway-app-url.railway.app/api
VITE_API_BASE_URL=/api

VITE_WALLETCONNECT_PROJECT_ID=

# Deployed ApexEscrow contract addresses (fill after running `forge script`)
VITE_ESCROW_ADDRESS_MAINNET=
VITE_ESCROW_ADDRESS_SEPOLIA=

VITE_USE_TESTNET=true